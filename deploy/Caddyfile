# HTTPS in front of the site: Caddy gets and renews the certificate for SITE_DOMAIN and compresses
# responses. Point the domain's DNS at this server first.
{$SITE_DOMAIN} {
	encode zstd gzip

	# The broadcast videos and their covers (modules/report-videos) straight from the data volume, with
	# byte ranges for seeking, instead of through the web and api processes. Only finished files match:
	# names the worker gives them, not its work folders. Anything else goes on to the api, which answers 404.
	@video path_regexp ^/api/videos/files/(daily|weekly)-[0-9W-]+-[0-9a-f]{16}\.(mp4|jpg|webp)$
	handle @video {
		uri strip_prefix /api/videos/files
		root * /srv/aihot/videos
		# A video's address changes with what it shows; a withdrawal removes the old file within minutes.
		header Cache-Control "public, max-age=300"
		file_server
	}

	handle {
		reverse_proxy web:3000
	}
}
